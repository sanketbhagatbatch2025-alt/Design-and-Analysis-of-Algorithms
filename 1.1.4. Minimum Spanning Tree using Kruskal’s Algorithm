#include <stdio.h>
#include <stdlib.h>
#include <limits.h>


typedef struct {
    int u, v, weight;
} Edge;


int *parent;
int *rankArr;

// Find function with path compression
int find(int i) {
    if (parent[i] != i)
        parent[i] = find(parent[i]); // Path compression
    return parent[i];
}


void unite(int i, int j) {
    int rootI = find(i);
    int rootJ = find(j);

    if (rootI != rootJ) {
        if (rankArr[rootI] < rankArr[rootJ]) {
            parent[rootI] = rootJ;
        } else if (rankArr[rootI] > rankArr[rootJ]) {
            parent[rootJ] = rootI;
        } else {
            parent[rootJ] = rootI;
            rankArr[rootI]++;
        }
    }
}


int compareEdges(const void *a, const void *b) {
    Edge *edgeA = (Edge *)a;
    Edge *edgeB = (Edge *)b;

    if (edgeA->weight != edgeB->weight)
        return edgeA->weight - edgeB->weight;
    
    if (edgeA->u != edgeB->u)
        return edgeA->u - edgeB->u;
    
    return edgeA->v - edgeB->v;
}

void kruskalMST(int **cost, int V) {

    int maxEdges = V * (V - 1) / 2;
    Edge *edges = (Edge *)malloc(maxEdges * sizeof(Edge));
    int edgeCount = 0;

    for (int i = 0; i < V; i++) {
        for (int j = i + 1; j < V; j++) {
            // 9999 represents infinity (no edge)
            if (cost[i][j] != 9999) {
                edges[edgeCount].u = i;
                edges[edgeCount].v = j;
                edges[edgeCount].weight = cost[i][j];
                edgeCount++;
            }
        }
    }


    qsort(edges, edgeCount, sizeof(Edge), compareEdges);

 
    parent = (int *)malloc(V * sizeof(int));
    rankArr = (int *)calloc(V, sizeof(int)); 
    for (int i = 0; i < V; i++) {
        parent[i] = i;
    }

    int mstEdgeCount = 0;
    int totalCost = 0;
    int edgeIndex = 0;


    while (mstEdgeCount < V - 1 && edgeIndex < edgeCount) {
        Edge nextEdge = edges[edgeIndex];
        int rootU = find(nextEdge.u);
        int rootV = find(nextEdge.v);

        if (rootU != rootV) {
           
            printf("Edge %d:(%d, %d) cost:%d\n", mstEdgeCount, nextEdge.u, nextEdge.v, nextEdge.weight);
            
            unite(nextEdge.u, nextEdge.v);
            totalCost += nextEdge.weight;
            mstEdgeCount++;
        }
        edgeIndex++;
    }

 
    printf("Minimum cost= %d\n", totalCost);


    free(edges);
    free(parent);
    free(rankArr); }

int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
